  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-llm": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
